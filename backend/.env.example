# Local dev (recommended): SQLite — free, no Supabase IPv4
USE_LOCAL_SQLITE=true

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Cloud Postgres (only when USE_LOCAL_SQLITE=false):
# DATABASE_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_LOCATION=us-central1
VERTEX_MODEL_LITE=
VERTEX_MODEL_FLASH=
VERTEX_MODEL_PRO=
LLM_GATEWAY_ADMIN_KEY=

# Workflow agents: rules + Vertex Gemini (set false to force rules-only)
WORKFLOW_USE_LLM_AGENTS=true

# PDF uploads (stored under backend/uploads/)
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=15728640
