# === Production (Cloud Run + Cloud SQL + GCS) ===
# 这些值由 cloudbuild.yaml 通过 Secret Manager 自动注入
# 本文件仅作参考，不要 commit 实际密码

USE_LOCAL_SQLITE=false
STORAGE_MODE=gcs

# Cloud SQL (Unix socket via Cloud SQL Auth Proxy)
CLOUD_SQL_CONNECTION_NAME=just-site-493900-d9:us-central1:kyc-db
DB_USER=kyc
DB_NAME=kyc
# DB_PASSWORD → injected from Secret Manager at deploy time

# GCS
# GCS_BUCKET_NAME → injected from Secret Manager at deploy time
GCS_SIGNED_URL_EXPIRY=3600

# Vertex AI — uses service account (no ADC needed in Cloud Run)
VERTEX_PROJECT_ID=just-site-493900-d9
VERTEX_LOCATION=us-central1

# LLM cache TTL (hours, 0 = no expiry)
LLM_CACHE_TTL_HOURS=24

CORS_ORIGINS=https://kyc-frontend-xxxx-uc.a.run.app
